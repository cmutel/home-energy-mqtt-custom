# Copy to .env (git-ignored). All settings use the DORFSTEIG_ prefix.
DORFSTEIG_MQTT_HOST=192.168.1.192
DORFSTEIG_IOTAWATT_HOST=192.168.1.159

# Optional overrides
# DORFSTEIG_MQTT_PORT=1883
# DORFSTEIG_DB_PATH=/home/cmutel/.local/share/dorfsteig/dorfsteig.sqlite
# DORFSTEIG_LOG_LEVEL=INFO
# DORFSTEIG_CONTROL_HOST=127.0.0.1
# DORFSTEIG_CONTROL_PORT=8002
# DORFSTEIG_INFLUX_URL=http://localhost:8086

# House location for weather data (village level is enough)
# DORFSTEIG_LATITUDE=
# DORFSTEIG_LONGITUDE=
# DORFSTEIG_METEOSWISS_STATION=

# Pushover: application token and user key
# DORFSTEIG_PUSHOVER_TOKEN=
# DORFSTEIG_PUSHOVER_USER=
