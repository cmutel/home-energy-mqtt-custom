[Unit]
Description=Dorfsteig heating controller (ESP32 outputs + web UI on :8002)
Documentation=https://github.com/cmutel/home-energy-mqtt-custom
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=cmutel
WorkingDirectory=/home/cmutel/dorfsteig
EnvironmentFile=/home/cmutel/dorfsteig/.env
ExecStart=/home/cmutel/dorfsteig/.venv/bin/dorfsteig-control run
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
