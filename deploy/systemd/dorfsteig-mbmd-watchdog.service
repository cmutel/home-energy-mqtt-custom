# Stops mbmd while the inverter is unreachable and retries with growing pauses
# (see src/dorfsteig_control/mbmd_watchdog.py). Runs as root for systemctl.
#   sudo cp deploy/systemd/dorfsteig-mbmd-watchdog.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dorfsteig-mbmd-watchdog
[Unit]
Description=Dorfsteig watchdog: pause mbmd while the inverter is unreachable
Documentation=https://github.com/cmutel/home-energy-mqtt-custom
After=mbmd.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/cmutel/dorfsteig
ExecStart=/home/cmutel/dorfsteig/.venv/bin/dorfsteig-mbmd-watchdog
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
